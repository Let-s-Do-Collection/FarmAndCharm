{
  "schemaVersion": 1,
  "id": "farm_and_charm",
  "version": "${version}",
  "name": "[Let's Do] Farm & Charm",
  "description": "The farm calls: Experience the art of advanced agriculture and farmhouse cuisine! Use mincers, cooking pots, as well as new grains and fruit varieties to enhance your culinary and agricultural skills.",
  "authors": [
    "satisfy"
  ],
  "contributors": [
    "MissLilitu",
    "CR-055",
    "Jason13Official"
  ],
  "contact": {
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub",
    "sources": "https://github.com/satisfyu/FarmAndCharm",
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/farm-and-charm/"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.farm_and_charm.fabric.FarmAndCharmFabric"
    ],
    "client": [
      "net.satisfy.farm_and_charm.fabric.client.FarmAndCharmClientFabric"
    ],
    "rei_client": [
      "net.satisfy.farm_and_charm.fabric.core.rei.FarmAndCharmReiClientPluginFabric"
    ],
    "emi": [
      "net.satisfy.farm_and_charm.core.compat.emi.FarmAndCharmEmiPlugin"
    ],
    "jei_mod_plugin": [
      "net.satisfy.farm_and_charm.core.compat.jei.FarmAndCharmJEIPlugin"
    ],
    "modmenu": [
      "net.satisfy.farm_and_charm.fabric.core.config.ModMenu"
    ]
  },
  "mixins": [
    "FarmAndCharm.mixins.json",
    "farm_and_charm-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": ">=1.21.1 <1.22",
    "architectury": ">=13.0.8",
    "foundation": ">=1.0.3"
  },
  "conflicts": {
    "bakery": "<2.0.0",
    "brewery": "<2.0.0",
    "candlelight": "<2.0.0"
  },
  "suggests": {
    "Bakery - Farm&Charm compat": ">=2.0.0",
    "Brewery - Farm&Charm compat": ">=2.0.0",
    "Candlelight - Farm&Charm compat": ">=2.0.0"
  }
}
